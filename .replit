modules = ["nodejs-20", "web", "bash", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
LOG_LEVEL = "info"
MOBILE_MONEY_GATEWAY = "auto_clapay_first"
PAWAPAY_ENV = "production"
VAPID_PUBLIC_KEY = "BPy-4QOhhUbnX3apfyA2LBL8YohvcFVV-av01mEzhI9tzfJBjzXX1Eu5UREKtOnd6W37HGZrOFwmlbYIttLATgc"
VAPID_SUBJECT = "mailto:support@simix.site"
APP_URL = "https://simix.site"

[userenv.production]
GOOGLE_REDIRECT_URI = "https://simix.site/api/auth/google/callback"
CLAPAY_BASE_URL = "https://nw-api.clapay.app/nowallet/api"
NODE_ENV = "production"
PORT = "5000"

[userenv.development]
